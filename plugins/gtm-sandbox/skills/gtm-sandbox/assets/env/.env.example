# GTM Sandbox — environment template (committed; placeholders only).
# Copy to .env.development / .env.pilot / .env.production and fill real values.
# Real .env.* files are gitignored and never committed.

# --- CRM / sales ---
CRM_API_KEY=replace-me
CRM_BASE_URL=https://crm.example.com/api

# --- Email / sequencing ---
EMAIL_API_KEY=replace-me
SENDER_DOMAIN=mail.example.com

# --- Enrichment / data ---
ENRICHMENT_API_KEY=replace-me
WAREHOUSE_URL=postgres://user:password@host:5432/dbname

# --- Agent runtime ---
AGENT_MODEL=fast-model
GTM_TIMEZONE=America/Los_Angeles

# --- Safety ---
# Anything other than the literal "false" is a dry run.
# development and pilot default to dry run; production defaults to live.
DRY_RUN=true
MAX_ACTIONS_PER_RUN=25
DAILY_BUDGET_USD=0
