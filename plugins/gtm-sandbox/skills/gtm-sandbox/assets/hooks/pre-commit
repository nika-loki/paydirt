#!/usr/bin/env bash
# gtm-sandbox pre-commit guard — blocks accidental staging of .env files.
# Install: cp assets/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '(^|/)\.env(\..*)?$' \
  | grep -vE '(^|/)\.env\.example$' || true)"

if [ -n "$staged" ]; then
  printf 'blocked: .env files are never committed:\n%s\n\n' "$staged" >&2
  printf 'If a template changed, edit .env.example instead.\n' >&2
  printf 'To sync secret values to GitHub, run: scripts/sync-secrets.sh\n' >&2
  exit 1
fi
